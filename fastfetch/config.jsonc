{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Terminal welcome screen, colors match the bar/panels (Catppuccin Mocha)
  "logo": {
    "type": "builtin",
    "source": "CachyOS_small",
    "color": {
      "1": "#89B4FA",
      "2": "#B4BEFE"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "#89B4FA",
      "title": "#B4BEFE"
    },
    "key": {
      "width": 13
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    { "type": "os",       "key": "󰣇  OS",       "format": "{name}" },
    { "type": "kernel",   "key": "󰒋  Kernel" },
    { "type": "wm",       "key": "  WM" },
    { "type": "shell",    "key": "󰈺  Shell" },
    { "type": "terminal", "key": "󰆍  Terminal" },
    { "type": "packages", "key": "󰏖  Packages" },
    "break",
    { "type": "cpu",      "key": "󰍛  CPU" },
    { "type": "gpu",      "key": "󰢮  GPU", "hideType": "integrated" },
    { "type": "memory",   "key": "󰍹  Memory" },
    { "type": "disk",     "key": "󰋊  Disk", "folders": "/" },
    { "type": "battery",  "key": "󰁹  Battery" },
    { "type": "uptime",   "key": "󰅐  Uptime" },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}

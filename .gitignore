# Whitelist: ignore everything in ~/.config except the folders listed below.
# To track another config, add a line like:  !/ghostty/
/*
!/.gitignore
!/README.md
!/hypr/
!/quickshell/

# Terminal: ghostty + fish + starship prompt + fastfetch welcome screen
!/ghostty/
!/fastfetch/
!/starship/
!/fish/
/fish/*
!/fish/config.fish

# Machine state, changes every time the wallpaper changes
/hypr/current_wallpaper

# Backup copies
*.bak

# Personal logo image (cut from wallpaper art), kept local only
/fastfetch/logo.png

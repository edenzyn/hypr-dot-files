{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ── Terminal welcome card ────────────────────────────────────────────
  // Image logo (kitty graphics, ghostty) + tree-style sections.
  // Dynamic lines come from greet.sh (reads a cache, so it's instant).
  // fish passes the accent color, and swaps the image for a text logo in
  // terminals without image support.

  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/assets/jett.png",
    "width": 20,
    "height": 10,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "#89B4FA", "output": "#CDD6F4", "separator": "#45475A" },
    "key": { "width": 14 }
  },

  "modules": [
    "break",

    // Greeting + today
    { "type": "command", "key": " ", "keyWidth": 1, "outputColor": "1", "text": "~/.config/fastfetch/greet.sh hello" },
    { "type": "command", "key": " ", "keyWidth": 1, "outputColor": "38;2;166;173;200", "text": "~/.config/fastfetch/greet.sh today" },
    "break",

    // System
    { "type": "custom", "format": "╭─ 󰣇  System", "outputColor": "1" },
    { "type": "os",       "key": "├─ OS",      "format": "{name}" },
    { "type": "kernel",   "key": "├─ Kernel",  "format": "{release}" },
    { "type": "wm",       "key": "├─ WM",      "format": "{pretty-name}" },
    { "type": "shell",    "key": "├─ Shell",   "format": "{pretty-name}" },
    { "type": "command",  "key": "├─ Updates", "text": "~/.config/fastfetch/greet.sh updates" },
    { "type": "uptime",   "key": "╰─ Uptime" },

    // Hardware
    { "type": "custom", "format": "╭─ 󰍛  Hardware", "outputColor": "1" },
    { "type": "command",  "key": "├─ CPU",     "text": "~/.config/fastfetch/greet.sh cpu" },
    { "type": "command",  "key": "├─ GPU",     "text": "~/.config/fastfetch/greet.sh gpu 1" },
    { "type": "command",  "key": "├─ dGPU",    "text": "~/.config/fastfetch/greet.sh gpu 2" },
    { "type": "memory",   "key": "├─ Memory",  "format": "{used} / {total}  ·  {percentage}" },
    { "type": "disk",     "key": "╰─ Disk",    "folders": "/", "format": "{size-used} / {size-total}  ·  {size-percentage}" },
    "break",

    // Quote
    { "type": "command", "key": " ", "keyWidth": 1, "outputColor": "38;2;127;132;156;3", "text": "~/.config/fastfetch/greet.sh quote" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}

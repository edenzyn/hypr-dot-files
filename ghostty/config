# Ghostty - styled to match the Hyprland + Quickshell desktop
# (Catppuccin Mocha colors, same #121213 background as the bar and panels)

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = calt
font-feature = liga
adjust-cell-height = 6%

# Theme
theme = Catppuccin Mocha
background = #121213
background-opacity = 0.95
minimum-contrast = 1.1

# Window (Hyprland tiles it, so no title bar)
window-decoration = false
gtk-titlebar = false
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend
unfocused-split-opacity = 0.85

# Cursor
cursor-style = bar
cursor-style-blink = true

# Shell (login shell is fish; this was wrongly set to zsh before)
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Behaviour
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
link-url = true
scrollback-limit = 50000000

# Splits / tabs (Ctrl+Shift+...)
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
